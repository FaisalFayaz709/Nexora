{
  "name": "@nexora/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "@types/node": "22.13.10"
  },
  "prisma": {
    "seed": "node prisma/seed/seed.mjs"
  }
}
