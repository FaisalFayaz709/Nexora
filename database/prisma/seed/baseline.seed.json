  "businessRules": [
    {
      "id": "00000000-0000-7000-8000-000000016001",
      "triggerType": "supplier_invoice.approve",
      "subjectType": "SupplierInvoice",
      "name": "Invoice amount greater than PO amount blocks approval",
      "description": "Fraud/control rule: if supplier invoice amount is above matched PO amount, block approval until corrected or explicitly reviewed.",
      "severity": "CRITICAL",
      "conditionJson": {
        "all": [
          {
            "field": "invoiceTotalGreaterThanPoTotal",
            "operator": "EQ",
            "value": true
          }
        ]
      },
      "actionsJson": [
        {
          "effect": "BLOCK",
          "message": "Supplier invoice total exceeds the related purchase order total."
        }
      ],
      "active": true,
      "createdById": "00000000-0000-7000-8000-000000000201"
    },
    {
      "id": "00000000-0000-7000-8000-000000016002",
      "triggerType": "payment.create",
      "subjectType": "Payment",
      "name": "Same user creates vendor and payment requires secondary approval",
      "description": "Fraud/control rule: if the same user created a vendor and attempts payment, require secondary approval.",
      "severity": "HIGH",
      "conditionJson": {
        "all": [
          {
            "field": "sameUserCreatedVendorAndPayment",
            "operator": "EQ",
            "value": true
          }
        ]
      },
      "actionsJson": [
        {
          "effect": "REQUIRE_SECONDARY_APPROVAL",
          "approvalSubjectType": "Payment",
          "message": "Payment requires independent secondary approval."
        }
      ],
      "active": true,
      "createdById": "00000000-0000-7000-8000-000000000201"
    },
    {
      "id": "00000000-0000-7000-8000-000000016003",
      "triggerType": "inventory.adjustment.post",
      "subjectType": "StockAdjustment",
      "name": "Stock adjustment threshold requires warehouse manager approval",
      "description": "Fraud/control rule: large inventory corrections must not bypass approval thresholds.",
      "severity": "HIGH",
      "conditionJson": {
        "all": [
          {
            "field": "adjustmentQuantity",
            "operator": "GT",
            "value": 50
          }
        ]
      },
      "actionsJson": [
        {
          "effect": "REQUIRE_APPROVAL",
          "approvalSubjectType": "StockAdjustment",
          "approvalDefinitionHint": "Warehouse Manager approval",
          "message": "Large stock adjustment requires approval."
        }
      ],
      "active": true,
      "createdById": "00000000-0000-7000-8000-000000000201"
    },
    {
      "id": "00000000-0000-7000-8000-000000016004",
      "triggerType": "purchase.submit",
      "subjectType": "PurchaseOrder",
      "name": "High value purchase route manager finance director",
      "description": "Amount-based workflow route for high-value purchase approvals.",
      "severity": "HIGH",
      "conditionJson": {
        "all": [
          {
            "field": "amount",
            "operator": "GT",
            "value": 1000000
          }
        ]
      },
      "actionsJson": [
        {
          "effect": "REQUIRE_APPROVAL",
          "approvalSubjectType": "PurchaseOrder",
          "approvalDefinitionHint": "Manager + Finance + Director",
          "message": "High-value purchase requires multi-step approval."
        }
      ],
      "active": true,
      "createdById": "00000000-0000-7000-8000-000000000201"
    }
  ]
