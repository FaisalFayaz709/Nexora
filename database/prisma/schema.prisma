generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  PASSWORD_EXPIRED
  DISABLED
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash        String     @db.Text
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(6)
  lastLoginAt         DateTime?  @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  sessions         Session[]
  mfaCredentials   MfaCredential[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMembership[]
  employees        Employee[]
  auditLogs                 AuditLog[] @relation("AuditActor")
  configurationHistory      SystemConfigurationHistory[] @relation("ConfigurationActor")
  vendorOnboardingRequested VendorOnboardingRequest[] @relation("VendorOnboardingRequester")
  vendorOnboardingSubmitted VendorOnboardingRequest[] @relation("VendorOnboardingSubmitter")
  vendorOnboardingApproved  VendorOnboardingRequest[] @relation("VendorOnboardingApprover")
  stockCountsCreated        StockCount[] @relation("StockCountCreator")
  stockCountApprovals       StockCountApproval[] @relation("StockCountApprover")
  stockCountPostings        StockCountPosting[] @relation("StockCountPoster")
  approvalRequestsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions           ApprovalAction[] @relation("ApprovalActor")
  ticketsOpened              Ticket[] @relation("TicketOpenedBy")
  ticketComments             TicketComment[] @relation("TicketCommentAuthor")
  vendorRiskAssessments     VendorRiskAssessment[] @relation("VendorRiskAssessor")
  createdPurchaseContracts  PurchaseContract[] @relation("PurchaseContractCreator")
  approvedPurchaseContracts PurchaseContract[] @relation("PurchaseContractApprover")
  createdBlanketPurchaseOrders  BlanketPurchaseOrder[] @relation("BlanketPurchaseOrderCreator")
  approvedBlanketPurchaseOrders BlanketPurchaseOrder[] @relation("BlanketPurchaseOrderApprover")
  createdPurchaseReleaseOrders PurchaseReleaseOrder[] @relation("PurchaseReleaseOrderCreator")
  communicationLogsSent      CommunicationLog[] @relation("CommunicationSender")
  createdReportTemplates     ReportTemplate[] @relation("ReportTemplateCreator")
  createdSavedReports        SavedReport[] @relation("SavedReportCreator")
  createdScheduledReports    ScheduledReport[] @relation("ScheduledReportCreator")
  reportExecutionsRequested  ReportExecution[] @relation("ReportExecutionRequester")

  journalEntriesCreated JournalEntry[] @relation("JournalEntryCreator")

  @@index([status])
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.Text
  device           String?   @db.VarChar(255)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model MfaCredential {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  type            String   @db.VarChar(50)
  secretEncrypted String   @db.Text
  enabledAt       DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type])
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.Text
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(160)
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(200)
  currency  String   @db.VarChar(3)
  timezone  String   @db.VarChar(100)
  locale    String   @db.VarChar(35)
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  branches        Branch[]
  departments     Department[]
  teams           Team[]
  addresses       Address[]
  settings        OrganizationSetting[]
  roles           Role[]
  memberships     OrganizationMembership[]
  auditLogs       AuditLog[]
  businessEvents             BusinessEvent[]
  idempotencyKeys            IdempotencyKey[]
  employees                  Employee[]
  skills                     Skill[]
  customers                  Customer[]
  customerSites              CustomerSite[]
  vendors                    Vendor[]
  productCategories          ProductCategory[]
  products                   Product[]
  unitsOfMeasure             UnitOfMeasure[]
  warehouses                 Warehouse[]
  importTemplates            ImportTemplate[]
  numberSequences            NumberSequence[]
  numberSequenceReservations NumberSequenceReservation[]
  stockBalances              StockBalance[]
  stockTransactions          StockTransaction[]
  stockReservations          StockReservation[]
  stockTransfers             StockTransfer[]
  serialNumbers              SerialNumber[]
  batchLots                  BatchLot[]
  stockAdjustments           StockAdjustment[]
  featureOverrides           OrganizationFeature[]
  moduleConfigurations       ModuleConfiguration[]
  configurationHistory       SystemConfigurationHistory[]
  saasSubscriptions          SaaSSubscription[]
  vendorOnboardingRequests   VendorOnboardingRequest[]
  stockCounts                StockCount[]
  inventoryCostLayers        InventoryCostLayer[]
  approvalDefinitions        ApprovalDefinition[]
  approvalRequests           ApprovalRequest[]
  projects                   Project[]
  assets                     Asset[]
  assetInstallations         AssetInstallation[]
  assetHistories             AssetHistory[]
  assetWarranties            AssetWarranty[]
  assetQrTags                AssetQrTag[]
  assetRmas                  AssetRMA[]
  tickets                    Ticket[]
  ticketComments             TicketComment[]
  slaPolicies                SlaPolicy[]
  workOrders                 WorkOrder[]
  workOrderAssignments       WorkOrderAssignment[]
  technicianProfiles         TechnicianProfile[]
  serviceReports             ServiceReport[]
  serviceReportParts         ServiceReportPart[]
  serviceVisits              ServiceVisit[]
  serviceVisitLocations      ServiceVisitLocation[]
  technicianLocationPings    TechnicianLocationPing[]
  technicianRoutes           TechnicianRoute[]
  workOrderCheckIns          WorkOrderCheckIn[]
  workOrderCheckOuts         WorkOrderCheckOut[]
  maintenancePlans           MaintenancePlan[]
  maintenanceChecklists      MaintenanceChecklist[]
  vendorRiskAssessments     VendorRiskAssessment[]
  purchaseContracts         PurchaseContract[]
  blanketPurchaseOrders     BlanketPurchaseOrder[]
  purchaseReleaseOrders     PurchaseReleaseOrder[]
  communicationTemplates    CommunicationTemplate[]
  communicationLogs         CommunicationLog[]
  emailDeliveryLogs         EmailDeliveryLog[]
  smsDeliveryLogs           SmsDeliveryLog[]
  messageAttachments        MessageAttachment[]
  reportTemplates           ReportTemplate[]
  savedReports              SavedReport[]
  scheduledReports          ScheduledReport[]
  reportExecutions          ReportExecution[]
  attendanceRecords          Attendance[]
  leaveTypes                 LeaveType[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  payrollRuns                PayrollRun[]
  payrollItems               PayrollItem[]
  dashboardWidgets          DashboardWidget[]
  userDashboards            UserDashboard[]
  savedViews                SavedView[]

  customerInvoices CustomerInvoice[]
  supplierInvoices SupplierInvoice[]
  payments Payment[]
  paymentAllocations PaymentAllocation[]
  financeExpenses Expense[]
  financialPeriods FinancialPeriod[]
  accounts Account[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  creditNotes CreditNote[]
  debitNotes DebitNote[]

  @@index([status])
}

model Address {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  type           String   @db.VarChar(50)
  lines          Json     @db.JsonB
  city           String   @db.VarChar(120)
  region         String?  @db.VarChar(120)
  country        String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches                 Branch[]
  customerBillingAddresses Customer[]     @relation("CustomerBillingAddress")
  customerSites            CustomerSite[] @relation("CustomerSiteAddress")
  vendorBillingAddresses   Vendor[]       @relation("VendorBillingAddress")

  @@index([organizationId, type])
  @@index([organizationId, country, city])
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  addressId      String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  address      Address?     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  departments                Department[]
  memberships                OrganizationMembership[]
  employees                  Employee[]
  warehouses                 Warehouse[]
  numberSequences            NumberSequence[]
  numberSequenceReservations NumberSequenceReservation[]
  approvalRequests           ApprovalRequest[]

  journalLines JournalLine[]
  purchaseContracts PurchaseContract[]
  blanketPurchaseOrders BlanketPurchaseOrder[]
  purchaseReleaseOrders PurchaseReleaseOrder[]
  attendanceRecords Attendance[]
  payrollRuns PayrollRun[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, addressId])
}

model Department {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @db.Uuid
  branchId          String   @db.Uuid
  name              String   @db.VarChar(200)
  managerEmployeeId String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  teams           Team[]
  employees       Employee[]   @relation("EmployeeDepartment")
  managerEmployee Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId])
  @@index([organizationId, managerEmployeeId])
}

model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  departmentId   String   @db.Uuid
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employeeTeams EmployeeTeam[]

  @@index([organizationId, departmentId])
  @@index([organizationId, name])
}

model OrganizationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(160)
  valueJson      Json     @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(120)
  systemRole     Boolean  @default(false)
  mfaRequired    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId, systemRole])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  status         String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
}

model UserRole {
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String   @db.VarChar(160)
  subjectType    String   @db.VarChar(120)
  subjectId      String   @db.Uuid
  beforeJson     Json?    @db.JsonB
  afterJson      Json?    @db.JsonB
  ip             String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, subjectType, subjectId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
}

model BusinessEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  type           String    @db.VarChar(160)
  aggregateType  String    @db.VarChar(120)
  aggregateId    String    @db.Uuid
  payloadJson    Json      @db.JsonB
  occurredAt     DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, type, occurredAt])
  @@index([organizationId, type, publishedAt])
  @@index([organizationId, aggregateType, aggregateId, occurredAt])
  @@index([publishedAt, occurredAt])
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(255)
  route          String   @db.VarChar(255)
  requestHash    String   @db.VarChar(128)
  responseJson   Json?    @db.JsonB
  expiresAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, route, key])
  @@index([organizationId, expiresAt])
}


model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt, usedAt])
}

model FeatureFlag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(160)
  moduleKey      String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  defaultEnabled Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organizationOverrides OrganizationFeature[]
  reportTemplates       ReportTemplate[]
  dashboardWidgets      DashboardWidget[]

  @@index([moduleKey, key])
}

model OrganizationFeature {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  featureFlagId  String   @db.Uuid
  enabled        Boolean
  configJson     Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  featureFlag  FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Restrict)

  @@unique([organizationId, featureFlagId])
  @@index([organizationId, enabled])
}

model ModuleConfiguration {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  moduleKey      String   @db.VarChar(100)
  enabled        Boolean  @default(true)
  configJson     Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, moduleKey])
  @@index([organizationId, enabled])
}

model SystemConfigurationHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  subjectType    String   @db.VarChar(100)
  subjectKey     String   @db.VarChar(200)
  beforeJson     Json?    @db.JsonB
  afterJson      Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("ConfigurationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, subjectType, subjectKey, createdAt])
  @@index([organizationId, actorUserId, createdAt])
}

model SaaSPlan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique @db.VarChar(100)
  name       String   @db.VarChar(200)
  moduleKeys Json     @db.JsonB
  limitsJson Json     @db.JsonB
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  subscriptions SaaSSubscription[]
}

model SaaSSubscription {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  planId         String    @db.Uuid
  status         String    @db.VarChar(50)
  startsAt       DateTime  @db.Timestamptz(6)
  endsAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         SaaSPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, startsAt])
}

model VendorOnboardingRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @db.Uuid
  vendorId          String    @db.Uuid
  approvalRequestId String?   @db.Uuid
  status            String    @default("DRAFT") @db.VarChar(50)
  documentEvidenceJson Json? @db.JsonB
  bankEvidenceJson     Json? @db.JsonB
  categoryIdsJson      Json? @db.JsonB
  documentsVerifiedAt  DateTime? @db.Timestamptz(6)
  bankVerifiedAt       DateTime? @db.Timestamptz(6)
  riskScore            Int?
  riskRating           String? @db.VarChar(40)
  approvedCategoryIdsJson Json? @db.JsonB
  blacklistReason      String? @db.Text
  rejectedAt           DateTime? @db.Timestamptz(6)
  requestedByUserId String    @db.Uuid
  submittedByUserId String?   @db.Uuid
  approvedByUserId  String?   @db.Uuid
  submittedAt       DateTime? @db.Timestamptz(6)
  approvedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("VendorOnboardingRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  submittedBy  User?        @relation("VendorOnboardingSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("VendorOnboardingApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  approvalRequest ApprovalRequest? @relation("VendorOnboardingApproval", fields: [approvalRequestId], references: [id], onDelete: Restrict)
  riskAssessments VendorRiskAssessment[]

  @@unique([approvalRequestId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, vendorId, status])
}


model VendorDocument {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @db.Uuid
  vendorId            String    @db.Uuid
  onboardingRequestId String?   @db.Uuid
  documentId          String?   @db.Uuid
  documentType        String    @db.VarChar(80)
  verificationStatus  String    @default("PENDING") @db.VarChar(40)
  verifiedByUserId    String?   @db.Uuid
  verifiedAt          DateTime? @db.Timestamptz(6)
  expiresAt           DateTime? @db.Date
  rejectionReason     String?   @db.Text
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([organizationId, vendorId, documentType])
  @@index([organizationId, onboardingRequestId])
  @@index([organizationId, verificationStatus, expiresAt])
}

model VendorBankAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @db.Uuid
  vendorId            String    @db.Uuid
  onboardingRequestId String?   @db.Uuid
  accountTitle        String    @db.VarChar(200)
  bankName            String    @db.VarChar(160)
  branchName          String?   @db.VarChar(160)
  accountNumberMasked String    @db.VarChar(80)
  ibanMasked          String?   @db.VarChar(80)
  verificationStatus  String    @default("PENDING") @db.VarChar(40)
  verifiedByUserId    String?   @db.Uuid
  verifiedAt          DateTime? @db.Timestamptz(6)
  isPrimary           Boolean   @default(false)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([organizationId, vendorId, verificationStatus])
  @@index([organizationId, onboardingRequestId])
}

model VendorBlacklist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  vendorId       String    @db.Uuid
  reason         String    @db.Text
  status         String    @default("ACTIVE") @db.VarChar(40)
