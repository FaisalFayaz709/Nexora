  idempotencyKey String?   @db.VarChar(200)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  webhook      IntegrationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, webhookId, status])
  @@index([organizationId, status, createdAt])
  @@unique([organizationId, webhookId, idempotencyKey])
}

model IntegrationSyncLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  connectionId   String   @db.Uuid
  direction      String   @db.VarChar(20)
  subjectType    String   @db.VarChar(120)
  subjectId      String?  @db.Uuid
  status         String   @db.VarChar(40)
  message        String?  @db.Text
  payloadJson    Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, connectionId, createdAt])
  @@index([organizationId, subjectType, subjectId])
}
