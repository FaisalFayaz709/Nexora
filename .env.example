NODE_ENV=development
FRONTEND_PORT=3000
API_PORT=3001
DATABASE_URL=postgresql://nexora:nexora@postgres:5432/nexora?schema=public
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=nexora-local
MINIO_SECRET_KEY=change-me-local-only
MINIO_PRIVATE_BUCKET=nexora-private
MINIO_PUBLIC_BUCKET=nexora-public
MINIO_UPLOAD_URL_TTL_SECONDS=900
MINIO_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_ENFORCE_OBJECT_CHECKSUM=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_REFRESH_COOKIE_NAME=nexora_refresh
AUTH_BCRYPT_COST=12
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_MFA_RATE_LIMIT=10
AUTH_MFA_RATE_WINDOW_SECONDS=300
# 32 random bytes, base64 encoded. Generate outside source control.
AUTH_MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
OPENAPI_DOCS_ENABLED=false
# BullMQ worker/runtime controls
WORKER_CONCURRENCY=5
WORKER_JOB_ATTEMPTS=5
WORKER_JOB_BACKOFF_MS=5000
WORKER_REMOVE_COMPLETE_AGE_SECONDS=86400
WORKER_REMOVE_FAILED_AGE_SECONDS=604800
WORKER_SCHEDULERS_ENABLED=true
WORKER_EMAIL_DELIVERY_ENABLED=false
WORKER_WEBHOOK_DELIVERY_ENABLED=false
